#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"
python3 "$root/tests/news_model_test.py"
bash -n "$root/demo/run"
python3 -m json.tool "$root/demo/fixtures/news.json" >/dev/null
command -v node >/dev/null 2>&1 || printf 'note: node missing, fixture checks skipped by news_model_test.py\n'

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

printf 'All portable plugin checks passed.\n'
